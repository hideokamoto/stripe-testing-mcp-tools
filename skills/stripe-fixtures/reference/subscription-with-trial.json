{
  "_meta": {
    "template_version": 0
  },
  "fixtures": [
    {
      "name": "clock",
      "path": "/v1/test_helpers/test_clocks",
      "method": "post",
      "params": {
        "frozen_time": 1759276800,
        "name": "subscription-with-trial-clock"
      }
    },
    {
      "name": "cus",
      "path": "/v1/customers",
      "method": "post",
      "params": {
        "name": "Trial Test Customer",
        "test_clock": "${clock:id}",
        "metadata": {
          "test_session": "stripe-fixtures-trial"
        }
      }
    },
    {
      "name": "pm",
      "path": "/v1/payment_methods",
      "method": "post",
      "params": {
        "type": "card",
        "card": {
          "number": "4242424242424242",
          "exp_month": 12,
          "exp_year": 2030,
          "cvc": "314"
        }
      }
    },
    {
      "name": "attach_pm",
      "path": "/v1/payment_methods/${pm:id}/attach",
      "method": "post",
      "params": {
        "customer": "${cus:id}"
      }
    },
    {
      "name": "default_pm",
      "path": "/v1/customers/${cus:id}",
      "method": "post",
      "params": {
        "invoice_settings": {
          "default_payment_method": "${pm:id}"
        }
      }
    },
    {
      "name": "product",
      "path": "/v1/products",
      "method": "post",
      "params": {
        "name": "Trial Test Product"
      }
    },
    {
      "name": "price",
      "path": "/v1/prices",
      "method": "post",
      "params": {
        "currency": "usd",
        "unit_amount": 1500,
        "product": "${product:id}",
        "recurring": {
          "interval": "month"
        }
      }
    },
    {
      "name": "sub",
      "path": "/v1/subscriptions",
      "method": "post",
      "params": {
        "customer": "${cus:id}",
        "items": [
          {
            "price": "${price:id}"
          }
        ],
        "trial_period_days": 14,
        "metadata": {
          "test_session": "stripe-fixtures-trial"
        }
      }
    },
    {
      "name": "advance_past_trial",
      "path": "/v1/test_helpers/test_clocks/${clock:id}/advance",
      "method": "post",
      "params": {
        "frozen_time": 1760572800
      }
    }
  ]
}
