{
  "_meta": {
    "template_version": 0
  },
  "fixtures": [
    {
      "name": "product",
      "path": "/v1/products",
      "method": "post",
      "params": {
        "name": "Checkout Test Product",
        "metadata": {
          "test_session": "stripe-fixtures-successful-checkout"
        }
      }
    },
    {
      "name": "price",
      "path": "/v1/prices",
      "method": "post",
      "params": {
        "currency": "usd",
        "unit_amount": 3000,
        "product": "${product:id}"
      }
    },
    {
      "name": "checkout_session",
      "path": "/v1/checkout/sessions",
      "method": "post",
      "params": {
        "mode": "payment",
        "success_url": "https://example.com/success",
        "cancel_url": "https://example.com/cancel",
        "line_items": [
          {
            "price": "${price:id}",
            "quantity": 1
          }
        ],
        "metadata": {
          "test_session": "stripe-fixtures-successful-checkout"
        }
      }
    }
  ]
}
